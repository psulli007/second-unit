# ─────────────────────────────────────────────────────────────────────────────
# second-unit configuration.
#
#   cp config.example.env config.env     # config.env is gitignored
#
# Everything here is read by scripts/bootstrap.sh, scripts/dev-server.sh and
# lib/app-target.js. Nothing secret belongs in this file — see the R2 section.
# ─────────────────────────────────────────────────────────────────────────────

# --- The app you are filming -------------------------------------------------

# Where the running app lives. Point this at a local dev server, a staging
# deploy, or any URL — the recorders only need to be able to load it.
#
# The default is the bundled demo app (`node scripts/demo-app.js`), so a fresh
# clone can record a real video before you configure anything. Change it to your
# own app once you've confirmed the toolchain works.
APP_URL="http://localhost:5050"

# OPTIONAL: clone your app into ./app/ so the studio owns its own checkout and
# your product repo stays clean. Space-separated candidates, tried in order
# (different machines often have different git auth). Leave empty to skip
# cloning entirely and just film whatever APP_URL points at.
APP_REMOTES=""

# The dev-server command run inside ./app/ (only used when APP_REMOTES is set).
APP_DEV_COMMAND="npm run dev"
DEV_PORT=5173

# --- Readiness gate ----------------------------------------------------------
# Recorders must not start filming a half-mounted app. Set ONE of these; the
# recorder waits for it before the first frame. If both are empty it falls back
# to waiting for `load` plus APP_READY_DELAY_MS.
#
#   APP_READY_SELECTOR  — a CSS selector that only exists once the app is live
#   APP_READY_FUNCTION  — name of a global function/property the app defines
APP_READY_SELECTOR="[data-testid=main-content]"
APP_READY_FUNCTION=""
APP_READY_DELAY_MS=2000

# CSS injected into every recording — hide loading overlays, empty ad slots,
# cookie banners and other things that are true but not worth filming.
# Keep this to genuinely non-substantive chrome: never hide real UI to make a
# feature look better than it is.
APP_HIDE_CSS=""

# --- Output ------------------------------------------------------------------
# Where finished videos + INDEX.md go. Kept outside the repo by default so
# multi-GB masters never land in git.
LIBRARY_DIR="$HOME/video-library"

# --- Brand ------------------------------------------------------------------
# Used by the card/caption renderers (templates/, scripts/build-flowcut.js).
# These are the neutral defaults — override them with your own.
BRAND_NAME="Your Product"
BRAND_ACCENT="#4F46E5"
BRAND_ACCENT_2="#7C6BF5"
BRAND_INK="#1F2430"
BRAND_PAPER="#F7F7F9"
BRAND_FONT="Inter"

# --- Optional: S3-compatible object storage (Cloudflare R2, S3, MinIO) -------
# Used by scripts/r2-sync.js to push masters off the machine. Leave the bucket
# empty to disable. The ACCESS KEY and SECRET never go in this file — copy
# scripts/r2-env-example.sh to a gitignored location and source it instead.
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
R2_PREFIX="video-studio"
